# Copiez ce fichier en .env et remplissez avec vos vraies valeurs (ne committez jamais .env).

DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

PORT=3000

# Identifiants pour l'authentification HTTP Basic (middleware.js).
# Ne sont utilisés QUE par `vercel dev` — server.js / npm start les ignore
# complètement, l'app n'est donc pas protégée en local avec npm start.
BASIC_AUTH_USER=votre_identifiant
BASIC_AUTH_PASSWORD=un_mot_de_passe_solide
